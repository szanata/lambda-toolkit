{
  "name": "lambda-toolkit",
  "version": "2.1.2",
  "description": "A set of tools to help and simplify Node Js code development for AWS Lambdas",
  "keywords": [
    "AWS",
    "Athena",
    "CloudWatch",
    "DynamoDB",
    "Lambda",
    "S3",
    "SES",
    "SNS",
    "SQS",
    "SSM",
    "Timestream",
    "API Gateway"
  ],
  "files": [
    "./license",
    "./dist"
  ],
  "type": "module",
  "exports": {
    "require": "./dist/index.cjs",
    "import": "./dist/index.mjs"
  },
  "author": {
    "name": "Stéfano Zanata",
    "url": "https://szanata.com"
  },
  "contributors": [
    {
      "name": "Lorenzo Zanatta"
    }
  ],
  "scripts": {
    "build": "webpack --stats errors-only",
    "test": "node --experimental-test-module-mocks --test",
    "lint:fix": "eslint --fix",
    "lint": "eslint"
  },
  "license": "GNUv3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szanata/lambda-toolkit.git"
  },
